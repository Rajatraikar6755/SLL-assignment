generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TRAINER
  INSTITUTION
  PROGRAMME_MANAGER
  MONITORING_OFFICER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model User {
  id             String   @id @default(uuid())
  clerkUserId    String   @unique @map("clerk_user_id")
  name           String
  role           Role
  institutionId  String?  @map("institution_id")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relationships
  batchesAsTrainer  BatchTrainer[]
  batchesAsStudent  BatchStudent[]
  sessionsAsTrainer Session[]
  attendances       Attendance[]

  @@map("users")
}

model Batch {
  id            String   @id @default(uuid())
  name          String
  inviteCode    String?  @unique @map("invite_code")
  institutionId String   @map("institution_id")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relationships
  trainers  BatchTrainer[]
  students  BatchStudent[]
  sessions  Session[]

  @@map("batches")
}

model BatchTrainer {
  batchId   String @map("batch_id")
  trainerId String @map("trainer_id")

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer User  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([batchId, trainerId])
  @@map("batch_trainers")
}

model BatchStudent {
  batchId   String @map("batch_id")
  studentId String @map("student_id")

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([batchId, studentId])
  @@map("batch_students")
}

model Session {
  id        String   @id @default(uuid())
  batchId   String   @map("batch_id")
  trainerId String   @map("trainer_id")
  title     String
  date      DateTime @db.Date
  startTime DateTime @db.Time
  endTime   DateTime @db.Time
  createdAt DateTime @default(now()) @map("created_at")

  batch       Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer     User         @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@map("sessions")
}

model Attendance {
  id        String           @id @default(uuid())
  sessionId String           @map("session_id")
  studentId String           @map("student_id")
  status    AttendanceStatus
  markedAt  DateTime         @default(now()) @map("marked_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId]) // A student can only have one attendance record per session
  @@map("attendance")
}
